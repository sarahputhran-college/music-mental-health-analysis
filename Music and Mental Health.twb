      <column caption='frequency' datatype='string' name='[Calculation_1294221944217202688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Frequency (Classical)] = &apos;Very frequently&apos; &#13;&#10;   AND [Frequency (Country)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (EDM)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Folk)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Gospel)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Hip hop)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Jazz)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (K pop)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Latin)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Lofi)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Metal)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Pop)] = &apos;Very frequently&apos;&#13;&#10;   AND [Frequency (R&amp;B)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Rap)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Rock)]=&apos;Very frequently&apos;&#13;&#10;   AND [Frequency (Video game music)]=&apos;Very frequently&apos;&#13;&#10;THEN &apos;Very frequently&apos;&#13;&#10;ELSEIF [Frequency (Classical)] = &apos;Never&apos; &#13;&#10;   AND [Frequency (Country)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (EDM)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (Folk)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Gospel)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Hip hop)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (Jazz)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (K pop)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Latin)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Lofi)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Metal)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (Pop)] = &apos;Never&apos;&#13;&#10;   AND [Frequency (R&amp;B)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Rap)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Rock)]=&apos;Never&apos;&#13;&#10;   AND [Frequency (Video game music)]=&apos;Never&apos;&#13;&#10;THEN &apos;Never&apos;&#13;&#10;ELSEIF [Frequency (Classical)] =&apos;Sometimes&apos; &#13;&#10;   AND [Frequency (Country)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (EDM)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Folk)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Gospel)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Hip hop)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Jazz)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (K pop)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Latin)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Lofi)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Metal)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Pop)] =&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (R&amp;B)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Rap)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Rock)]=&apos;Sometimes&apos;&#13;&#10;   AND [Frequency (Video game music)]=&apos;Sometimes&apos;&#13;&#10;THEN &apos;Sometimes&apos;&#13;&#10;ELSEIF [Frequency (Classical)] = &apos;Rarely&apos; &#13;&#10;   AND [Frequency (Country)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (EDM)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (Folk)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Gospel)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Hip hop)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (Jazz)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (K pop)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Latin)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Lofi)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Metal)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (Pop)] = &apos;Rarely&apos;&#13;&#10;   AND [Frequency (R&amp;B)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Rap)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Rock)]=&apos;Rarely&apos;&#13;&#10;   AND [Frequency (Video game music)]=&apos;Rarely&apos;&#13;&#10;THEN &apos;Rarely&apos;&#13;&#10;END' />
      </column>
      <column caption='productivity levels' datatype='integer' name='[Calculation_1294221944377671682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Music effects] = &apos;Improve&apos; THEN 8&#13;&#10;ELSEIF [Music effects] = &apos;No Effect&apos; THEN 5&#13;&#10;ELSE 3&#13;&#10;END' />
      </column>
      <column caption='ANGLE' datatype='real' name='[Calculation_204350833663823876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(&#13;&#10;2*PI()/4)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age Distribution' datatype='string' name='[Calculation_204350833975619590]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 18 THEN &quot;Under 18&quot;&#13;&#10;ELSEIF [Age] &gt;= 18 AND [Age] &lt; 25 THEN &quot;18-24&quot;&#13;&#10;ELSEIF [Age] &gt;= 25 AND [Age] &lt; 35 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Age] &gt;= 35 AND [Age] &lt; 45 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Age] &gt;= 45 AND [Age] &lt; 55 THEN &quot;45-54&quot;&#13;&#10;ELSE &quot;55 and above&quot;&#13;&#10;END' />
      </column>
      <column caption='Frequencies' datatype='string' name='[Calculation_204350833983070216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Frequency (Classical)]+[Frequency (Country)]+[Frequency (EDM)]+[Frequency (Folk)]+[Frequency (Gospel)]+[Frequency (Hip hop)]+[Frequency (Jazz)]+[Frequency (K pop)]+[Frequency (Latin)]+[Frequency (Lofi)]+[Frequency (Metal)]+[Frequency (Pop)]+[Frequency (R&amp;B)]+[Frequency (Rap)]+[Frequency (Rock)]+[Frequency (Video game music)]' />
      </column>
      <column caption='self ranking' datatype='integer' name='[Calculation_204350833993715722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0-10' />
      </column>
      <column caption='count of anxiety' datatype='integer' name='[Calculation_204350833994178571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Anxiety])' />
      </column>
      <column caption='count of depression' datatype='integer' name='[Calculation_204350833994293260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Depression])' />
      </column>
      <column caption='count of insomania' datatype='integer' name='[Calculation_204350833995218957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Insomnia])' />
      </column>
      <column caption='count of ocd' datatype='integer' name='[Calculation_204350833995341838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([OCD])' />
      </column>
      <column caption='Mental Evaluation' datatype='integer' name='[Calculation_204350833995468815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_204350833994178571]+[Calculation_204350833994293260]+[Calculation_204350833995218957]+[Calculation_204350833995341838]' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_204350834009030673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Insomnia]+[OCD]+[Depression]+[Anxiety])/4' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_204350834022678546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0-10' />
      </column>
